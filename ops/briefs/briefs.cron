SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin
# Global brief: KST 07:00 Mon–Fri = UTC 22:00 Sun–Thu.
0 22 * * 0-4 root /usr/bin/flock -n /state/brief-global.lock /usr/local/bin/node /app/ops/briefs/run.mjs global >> /proc/1/fd/1 2>> /proc/1/fd/2
# KST 07:20 retry. A no-op once 07:00 published (the daily lock says "already ran today").
20 22 * * 0-4 root /usr/bin/flock -w 600 /state/brief-global.lock /usr/local/bin/node /app/ops/briefs/run.mjs global >> /proc/1/fd/1 2>> /proc/1/fd/2
# Korea close brief: KST 17:30 Mon–Fri = UTC 08:30 Mon–Fri.
30 8 * * 1-5 root /usr/bin/flock -n /state/brief-korea.lock /usr/local/bin/node /app/ops/briefs/run.mjs korea-close >> /proc/1/fd/1 2>> /proc/1/fd/2
# KST 17:50 retry, same rule.
50 8 * * 1-5 root /usr/bin/flock -w 600 /state/brief-korea.lock /usr/local/bin/node /app/ops/briefs/run.mjs korea-close >> /proc/1/fd/1 2>> /proc/1/fd/2
# Weekly digest email: KST Mon 09:00 = UTC Mon 00:00. No automatic retry — a
# state marker blocks double-sending and failures alert KK instead.
0 0 * * 1 root /usr/bin/flock -n /state/digest.lock /usr/local/bin/node /app/ops/briefs/run.mjs digest >> /proc/1/fd/1 2>> /proc/1/fd/2
