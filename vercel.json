{
  "cleanUrls": true,
  "redirects": [
    { "source": "/apply", "destination": "/join", "permanent": true },
    { "source": "/posts", "destination": "/thoughts", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": false },
    { "source": "/kk", "destination": "/#kk", "permanent": false }
  ],
  "crons": [
    { "path": "/api/cron/digest", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/daily-brief", "schedule": "0 22 * * 0-4" },
    { "path": "/api/cron/korea-close", "schedule": "30 8 * * 1-5" },
    { "path": "/api/cron/research-lab", "schedule": "0 23 * * 1,4" },
    { "path": "/api/cron/research-followup", "schedule": "0 * * * *" }
  ],
  "functions": {
    "api/cron/daily-brief.js": { "maxDuration": 60 },
    "api/cron/korea-close.js": { "maxDuration": 60 },
    "api/cron/research-lab.js": {
      "maxDuration": 300,
      "includeFiles": "{RESEARCH_PROMPT.md,research-config.json,posts/**}"
    },
    "api/cron/research-followup.js": { "includeFiles": "research-config.json" },
    "api/research-decide.js": { "includeFiles": "research-config.json" }
  }
}
