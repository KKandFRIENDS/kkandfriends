# Copy to ops/briefs/.env on the VPS (chmod 600). Never commit the real file.

# Required — must be byte-identical to EDITORIAL_INTERNAL_TOKEN in the API server's env file.
EDITORIAL_INTERNAL_TOKEN=

# Required — one writing key. The first present wins: Gemini → OpenRouter → AI Gateway → Anthropic.
# GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated fallback list, tried in order.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-flash-0731:nitro,z-ai/glm-5.3-flash
# low (default) | none | medium — keeps reasoning models from using the whole budget on thinking.
# OPENROUTER_REASONING_EFFORT=low
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram — failure alerts go to TELEGRAM_CHAT_ID (KK), teasers to TELEGRAM_CHANNEL_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Weekly digest email (same values as the API server's env file).
RESEND_API_KEY=
RESEND_FROM=

# Optional — Bank of Korea ECOS macro backdrop.
ECOS_API_KEY=

# Optional — official statistics for the 17:30 brief and the law watch.
# The brief only uses them when STATS_IN_BRIEFS=1 (default off); missing keys just drop that provider.
# DART_API_KEY=      # OpenDART 공시 (opendart.fss.or.kr)
# OPENLAW_OC=        # 법제처 OC id (open.law.go.kr)
# KOSIS_API_KEY=     # 통계청 KOSIS (kosis.kr/openapi), 물가·인구
# STATS_IN_BRIEFS=1
# OPENLAW_WATCH=     # comma-separated exact law names; default is the 자본시장법 family
# OPENLAW_BASE=      # default https://www.law.go.kr (use http:// only if https is reset)

# Optional overrides.
# COMMUNITY_API_URL=https://api.kkandfriends.com
# SITE_URL=https://www.kkandfriends.com
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
