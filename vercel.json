{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/apply",
      "destination": "/join",
      "permanent": true
    },
    {
      "source": "/posts",
      "destination": "/thoughts",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": false
    },
    {
      "source": "/kk",
      "destination": "/#kk",
      "permanent": false
    },
    {
      "source": "/markets",
      "destination": "/thoughts?series=Daily%20Markets",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/desk/:slug",
      "destination": "/api/desk?view=page&slug=:slug"
    },
    {
      "source": "/original/:slug",
      "destination": "/api/desk?view=original&slug=:slug"
    },
    {
      "source": "/markets/:slug",
      "destination": "/api/desk?view=market&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/desk?view=sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/desk?view=rss"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/desk?view=rss"
    },
    {
      "source": "/linkedin.xml",
      "destination": "/api/desk?view=linkedin"
    },
    {
      "source": "/instagram.xml",
      "destination": "/api/desk?view=instagram"
    },
    {
      "source": "/card/:kind/:slug",
      "destination": "/api/desk?view=card&kind=:kind&slug=:slug"
    }
  ],
  "functions": {
    "api/editorial.js": {
      "maxDuration": 60
    },
    "api/editorial-worker.js": {
      "maxDuration": 60
    },
    "api/desk.js": {
      "maxDuration": 30,
      "includeFiles": "fonts/Pretendard-*.otf"
    }
  }
}
