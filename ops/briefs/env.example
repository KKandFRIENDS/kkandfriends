# Copy to ops/briefs/.env on the VPS (chmod 600). Never commit the real file.

# Required — must be byte-identical to EDITORIAL_INTERNAL_TOKEN in the API server's env file.
EDITORIAL_INTERNAL_TOKEN=

# Required — one writing key. The first present wins: Gemini → OpenRouter → AI Gateway → Anthropic.
# GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated fallback list, tried in order.
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram — failure alerts go to TELEGRAM_CHAT_ID (KK), teasers to TELEGRAM_CHANNEL_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=

# Weekly digest email (same values as the API server's env file).
RESEND_API_KEY=
RESEND_FROM=

# Optional — Bank of Korea ECOS macro backdrop.
ECOS_API_KEY=

# Optional overrides.
# COMMUNITY_API_URL=https://api.kkandfriends.com
# SITE_URL=https://www.kkandfriends.com
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
